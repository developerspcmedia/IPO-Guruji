# Required: Full JSON string of your Firebase service account key (never commit the real key)
FIREBASE_SERVICE_ACCOUNT=

# Optional: Run mode: all | catalog | gmp | subscription (defaults to "all")
RUN_MODE=all

# Optional: Free-tier Gemini API key for HTML table fallback when cheerio extracts 0 rows
GEMINI_API_KEY=

# Optional: Gemini Flash model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
